epd:id_2023-S-210-661197_Procedure_faF7Q5dyoGpXu3Ru4RGg73 a epo:Procedure;
  epo:hasDescription "le présent Marché porte sur la sélection d'un prestataire externe capable de mesurer, d'analyser, et de suivre l'empreinte environnementale et climat du Portefeuille d'actifs financiers du Frr.L'Empreinte environnementale et climat doit notamment permettre au FRR d'identifier les actifs à forte empreinte carbone (émissions et réserves de GES, charbon...), ceux générateurs de risques physiques et de transition, le tout dans le respect de l'objectif international de limitation du réchauffement climatique"@fr;
  epo:hasID epd:id_2023-S-210-661197_ProcedureIdentifier_faF7Q5dyoGpXu3Ru4RGg73;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot epd:id_2023-S-210-661197_Lot_DgNm7RuiSQ47VBTvdrHsRv;
  epo:hasPurpose epd:id_2023-S-210-661197_ProcedurePurpose_faF7Q5dyoGpXu3Ru4RGg73;
  epo:hasTitle "marche 2023frr01 - prestation de mesure et D'Analyse DE L'Empreinte environnementale et climat du portefeuille du frr "@fr;
  epo:isCoveredByGPA true .

