flowchart LR
  %% Pools represented as subgraphs

  subgraph CONSUMER["Consumer / Curator"]
    C1([Start])
    C2["Request Resolved Entity"]
    C3["Receive Canonical Identifier"]
    C4([End])
    C1 --> C2 --> C3 --> C4
  end

  subgraph ERS["ER System"]
    E1["Receive Lookup Request"]
    E2["Query Registry"]
    E3{"Entity Found?"}
    E4["Return Canonical Identifier"]
    E5["Return Not Found"]
    E1 --> E2 --> E3
    E3 -->|Yes| E4
    E3 -->|No| E5
  end

  %% Message flows
  C2 -.-> E1
  E4 -.-> C3
  E5 -.-> C3
