flowchart TD
  %% IMPROVED S1 BPMN - Four swimlanes with link curation phase
  %% Shows: Cache logic, automated resolution, threshold gate, manual curation, state updates

  subgraph TED["🔵 TED-SWS Pipeline"]
    T1([Start])
    T2["Submit Entity Mention<br/>for Resolution"]
    T3["Receive Canonical<br/>Identifier"]
    T4([End])
    T1 --> T2
    T3 --> T4
  end

  subgraph ERS["🟢 ER System (Orchestration)"]
    E1["Receive Resolution<br/>Request"]
    E2["Validate &amp; Register<br/>Request"]
    E3{"Cache Hit?<br/>(Resolution<br/>required?)"}
    E3a["Return Cached<br/>Canonical ID"]
    E4["Send Resolution<br/>Request to ERE"]
    E5["Receive Alignment<br/>Links + Confidence<br/>Scores"]
    E6{"All Links Above<br/>Acceptance<br/>Threshold?"}
    E6a["Auto-Accept Top<br/>Confidence Link"]
    E7["Present Candidates<br/>to Curator"]
    E8["Receive Curation<br/>Decision"]
    E9["Retrieve Final<br/>Canonical ID<br/>from Registry"]

    E1 --> E2 --> E3
    E3 -->|No| E3a
    E3 -->|Yes| E4
    E4 --> E5
    E5 --> E6
    E6 -->|Yes| E6a
    E6 -->|No| E7
    E6a --> E9
    E7 --> E8
    E8 --> E9
  end

  subgraph ERE["🔴 Entity Resolution Engine"]
    R1["Receive Resolution<br/>Request"]
    R2["Match &amp; Link<br/>Entity"]
    R3["Return Alignment<br/>Links with<br/>Confidence Scores"]
    R1 --> R2 --> R3
  end

  subgraph CUR["🟡 Link Curation"]
    C1["Review Candidate<br/>Links &amp; Confidence"]
    C2{"Curator<br/>Decision?"}
    C2a["Accept Top<br/>Confidence Link"]
    C2b["Reject All<br/>Links"]
    C2c["Manage Confidence<br/>Scores"]
    C3a["→ Write to<br/>Canonical Registry<br/>(integrate link)"]
    C3b["→ Write to<br/>Link-Store<br/>(mark -1 confidence)"]
    C3c["→ Update Both<br/>Stores<br/>(new confidence)"]

    C1 --> C2
    C2 -->|Accept| C2a --> C3a
    C2 -->|Reject| C2b --> C3b
    C2 -->|Manage| C2c --> C3c
  end

  subgraph STORES["💾 State Stores"]
    S1["Canonical Registry<br/>(canonical entity state,<br/>cluster assignments)"]
    S2["Link-Store<br/>(alignment decisions,<br/>confidence audit trail)"]
    S3["Cache<br/>(resolved entity<br/>identifiers)"]
  end

  %% MESSAGE FLOWS (inter-swimlane communication)

  %% TED-SWS to ER System
  T2 -.->|Entity Mention<br/>Representation| E1

  %% ER System to ERE
  E4 -.->|Resolution Request| R1

  %% ERE to ER System
  R3 -.->|Alignment Links| E5

  %% ER System to Curation
  E7 -.->|Candidate Links| C1

  %% Curation to State Stores
  C3a -.->|Integrate Link| S1
  C3b -.->|Reject Links| S2
  C3c -.->|Update Confidence| S1
  C3c -.->|Audit Trail| S2

  %% State Stores back to ER System
  S1 -.->|Canonical ID| E9
  S3 -.->|Cached ID| E3a

  %% ER System to TED-SWS
  E3a -.->|Canonical ID| T3
  E9 -.->|Canonical ID| T3

  %% STYLING
  classDef pool fill:#f0f0f0,stroke:#333,stroke-width:2px,color:#000
  classDef gateway fill:#ffeb99,stroke:#333,stroke-width:2px,color:#000
  classDef task fill:#fff4e6,stroke:#333,stroke-width:1px,color:#000
  classDef store fill:#e6f3ff,stroke:#333,stroke-width:2px,color:#000
  classDef decision fill:#ffe6e6,stroke:#333,stroke-width:2px,color:#000

  class TED,ERS,ERE,CUR,STORES pool
  class E3,E6,C2 gateway
  class S1,S2,S3 store
