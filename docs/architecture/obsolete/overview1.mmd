sequenceDiagram
%% =====================================================================
%% ERSys – Canonical sequence diagram template
%% Maps to EA diagram: UML Sequence
%% Rules:
%% - Keep participants to services/systems; avoid internal algorithms
%% - Show contracts as explicit participants
%% - Show MessagingMiddleware explicitly for async flows
%% - Include stores only when they add architectural value
%% =====================================================================

%% External systems and client roles
actor Curator as "Curator"
actor SystemAdministrator as "System Administrator"
participant Originator as "Originator"
participant DownstreamConsumer as "Downstream Consumer"

box "Link Curation Application"
    participant LinkCurationApp as "Link Curation Web Application"
    participant LinkCurationAPI as "Link Curation REST API"
end

box "Entity Resolution System (ERSys)"
    %% Service-facing entry points (choose the one relevant for the spine)
    participant ERIntake as "Entity Resolution Intake Service"
    participant CanonicalLookup as "Canonical Lookup Service"
    participant LinkCurationSvc as "Link Curation Service"
    participant RebuildSvc as "Rebuild Service"

    %% Authority and orchestration
    participant ERS as "Entity Resolution Service (ERS)"

    %% Authoritative state (include only if needed)
    participant RequestRegistry as "Request Registry"
    participant DecisionStore as "Resolution Decision Store"
    participant CanonicalRegistry as "Canonical Entity Registry"
end

%% Contract and transport (explicit)
participant MessagingMiddleware as "Messaging Middleware"

box "Entity Resolution Engine (ERE)"
    participant ERE as "Entity Resolution Engine (ERE)"
end


%% ---------------------------------------------------------------------
%% Template interaction skeleton (replace messages with spine-specific ops)
%% ---------------------------------------------------------------------

%% 1) Client-facing call (sync)
Originator ->> ERIntake: Resolve Entity Mention (originatorId, originatorRequestId, entityType, EntityMention)
activate ERIntake
ERIntake ->> ERS: Validate + register request (idempotent)
activate ERS

%% Optional: show authoritative persistence only when relevant
%% ERS ->> RequestRegistry: Upsert request record
%% ERS ->> DecisionStore: Ensure current Resolution Decision exists
%% ERS ->> CanonicalRegistry: Ensure canonical projection exists

ERS -->> ERIntake: Canonical Identifier + status (bounded)
deactivate ERS
ERIntake -->> Originator: Canonical Identifier + status (bounded)
deactivate ERIntake

%% 2) Asynchronous engine interaction (decoupled)
ERS ->> MessagingMiddleware: Publish Resolution Request (correlation keys)
MessagingMiddleware ->> ERS_ERE_Contract: Deliver request (at-least-once)
ERS_ERE_Contract ->> ERE: Consume request

%% ERE proposes candidates (advisory)
ERE ->> ERS_ERE_Contract: Publish candidate alignments (correlation keys)
ERS_ERE_Contract ->> MessagingMiddleware: Deliver response (at-least-once)
MessagingMiddleware ->> ERS: Consume response

%% 3) Integration into governance model (no authority leakage)
activate ERS
ERS ->> ERS: Integrate proposals under decision-centric governance
%% Optional: show store updates if this spine is about authority/projection
%% ERS ->> DecisionStore: Update decision context / status
%% ERS ->> CanonicalRegistry: Update serving projection (governed)
deactivate ERS

